<?xml version="1.0" encoding="UTF-8"?>
<!--
  PowerPoint Content Add-in Manifest
  ===================================
  This is a ContentApp (not TaskPaneApp). It renders as an interactive iframe
  embedded directly inside the slide. The user inserts it via Insert → My Add-ins,
  and it appears as a resizable, interactive web object on the slide canvas.

  Content add-ins are supported in PowerPoint on the web and PowerPoint for Windows/Mac.
-->
<OfficeApp
  xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:type="ContentApp">

  <Id>b2c3d4e5-f6a7-8901-bcde-f12345678901</Id>
  <Version>1.0.0.0</Version>
  <ProviderName>Scatterplot Map</ProviderName>
  <DefaultLocale>en-US</DefaultLocale>
  <DisplayName DefaultValue="Interactive Scatterplot Map" />
  <Description DefaultValue="An interactive, zoomable scatterplot map embedded directly in your PowerPoint slide. Pan, zoom, hover, click, search, filter, and import CSV data — all live inside the slide." />
  <IconUrl DefaultValue="https://localhost:3000/powerpoint-addin/assets/icon-32.png" />
  <HighResolutionIconUrl DefaultValue="https://localhost:3000/powerpoint-addin/assets/icon-64.png" />

  <SupportUrl DefaultValue="https://localhost:3000/" />

  <Hosts>
    <Host Name="Presentation" />
  </Hosts>

  <Requirements>
    <Sets>
      <Set Name="ActiveView" MinVersion="1.1" />
    </Sets>
  </Requirements>

  <DefaultSettings>
    <SourceLocation DefaultValue="https://localhost:3000/powerpoint-addin/content.html" />
    <RequestedWidth>800</RequestedWidth>
    <RequestedHeight>500</RequestedHeight>
  </DefaultSettings>

  <Permissions>ReadWriteDocument</Permissions>

  <AllowSnapshot>true</AllowSnapshot>
</OfficeApp>
